<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose. Day and night (values-night) use the theme's background, so
         there is no white flash in dark mode. Primary is the brand teal (android-app.md §7.2). -->
    <style name="Theme.Eksoda" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/eksoda_primary</item>
        <item name="android:windowBackground">@color/eksoda_window_background</item>
    </style>

    <!-- Shown while the app starts; MainActivity keeps it until the database has opened. -->
    <style name="Theme.Eksoda.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/eksoda_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Eksoda</item>
    </style>

    <color name="eksoda_primary">#00897B</color>
</resources>
