<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the redesign's dark base in both system modes until a light
         theme is designed (docs/design/ui-redesign.md §1), so there is no white flash. Primary
         is terracotta. values-night repeats this theme. -->
    <style name="Theme.Eksoda" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/eksoda_primary</item>
        <item name="android:windowBackground">@color/eksoda_window_background</item>
    </style>

    <!-- Shown while the app starts; MainActivity keeps it until the database has opened. -->
    <style name="Theme.Eksoda.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/eksoda_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Eksoda</item>
    </style>

    <color name="eksoda_primary">#E2795A</color>
</resources>
