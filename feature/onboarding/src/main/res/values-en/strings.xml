    <string name="onboarding_title">Welcome to Eksoda</string>
    <string name="onboarding_promise_title">Your receipts never leave your phone</string>
    <string name="onboarding_promise_body">Eksoda uses the network only to download a receipt you scanned, from the company that issued it. There are no accounts, no Eksoda servers, no analytics and no crash reporting. Backups are encrypted with a passphrase only you know.</string>
